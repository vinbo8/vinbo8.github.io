---
import { Image } from "astro:assets";
import Container from "@components/Container.astro";
import PageLayout from "@components/PageLayout.astro";

import profileImage from '../img/vinit3.jpg';

import { Icon } from 'astro-icon/components'
---

<PageLayout title="vinit - about"> 
    <div class="content space-y-16">
      <div class="flex flex-col-reverse sm:flex-row sm:space-x-8">
        <div class="w-full sm:w-3/4">
          <div>
            <p class="animate">
              I am an interdisciplinary researcher, writer, and editor, based between Copenhagen and Berlin. I am a founding editor of the recently-launched magazine <a href="https://disjunctionsmag.com" aria-label="Disjunctions">Disjunctions</a>, and serve on the editorial board for <a href="https://theleftberlin.com" aria-label="The Left Berlin">The Left Berlin</a>.
            </p> 
            <br>
            <p class="animate">
              I currently work as a postdoctoral researcher at the University of Copenhagen; my work focuses on analysing the effect that the use of generative AI has upon how academic research is conducted. My academic interests also focus on the analysis and critique of the broader political economy of contemporary technology, technological infrastructures, and the role they play under an ever-mutating capitalism. My doctoral dissertation focused on leveraging technical critiques of “multilinguality” in language models, through a perspective of linguistic theory and model interpretability.
            </p>
            <br>
            <p class="animate">
              
            </p>
          </div>
        </div>
        <div class="w-full sm:w-1/4 flex flex-col items-center animate mb-8 sm:mb-0 ">
          <Image src={profileImage} class="w-64 h-aut border-black border" alt="vinit"/>

          <div class="flex space-x-1 mt-2 text-sm">
            <a class="transition" target="_blank" rel="noopener noreferrer" href="mailto:vinit94@proton.me">
              <span>email</span>
              <!-- <Icon name="mail"/>  -->
            </a>
            <span>·</span>
            <a class="transition" target="_blank" rel="noopener noreferrer" href="https://www.linkedin.com/in/vinit-ravishankar-819349284/">
              <span>linkedin</span>
              <!-- <Icon name="bluesky"/>  -->
            </a>
            <span>·</span>
            <a class="transition" target="_blank" rel="noopener noreferrer" href="https://www.instagram.com/vinbo8__/">
              <span>instagram</span>
              <!-- <Icon name="instagram"/>  -->
            </a>
          </div>

        </div>
      </div>
    </div>
</PageLayout>
