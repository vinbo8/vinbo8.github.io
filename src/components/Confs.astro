let parsedconfs = confs.map(conf => {
  const datestring = parse(conf.date, 'dd.MM.yyyy', new Date());
  return {
    ...conf,
    datestring: datestring
  }
})


parsedconfs = parsedconfs.sort((a, b) => {
  return b.datestring - a.datestring; 
})

const now = new Date();

const pastconfs = parsedconfs.filter(conf => {
  return conf.datestring <= now
});

const futureconfs = parsedconfs.filter(conf => {
  return conf.datestring > now
});


---

<div class="content">
  <h2 class="animate">
    {section}
  </h2>

  <!-- <h4 class="animate">
    upcoming
  </h4> -->
  <div class="animate">
    <ul>
    {
      futureconfs.map(c => (
        <li class="entry">
          <span>"{c.title}"</span>
          <div class="flex justify-between"><span class="text-sm">{c.conf}, {c.location}</span><span class="text-right text-sm">{c.date}</span></div>
        </li>
      ))
    }
    </ul>
    <ul>
    {
      pastconfs.map(c => (
        <li class="entry outdated">
          <span class="leading-none">"{c.title}"</span>
          <div class="flex justify-between"><span class="leading-none text-sm">{c.conf}, {c.location}</span><span class="text-right text-sm leading-none">{c.date}</span></div>
        </li>
      ))
    }
    </ul>
  </div>
</div>